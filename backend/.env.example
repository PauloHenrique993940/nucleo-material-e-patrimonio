DATABASE_URL=postgresql://nucleo:nucleo_local@localhost:15432/nucleo?schema=public
# Em produção: DATABASE_URL usa o endpoint pooler do Neon com sslmode=require.
# Conexão direta opcional, utilizada por npm run db:deploy na raiz.
DIRECT_URL=
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_URL=http://localhost:5173
PORT=3001
SEED_ADMIN_EMAIL=admin@nucleo.local
SEED_ADMIN_PASSWORD=
SEED_DEMO_DATA=true

TEST_DATABASE_URL=postgresql://nucleo:nucleo_local@localhost:15432/nucleo_test?schema=public
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
