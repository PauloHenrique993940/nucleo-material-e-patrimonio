{
  "name": "nucleo-material-patrimonio",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces",
    "build:vercel": "npm run db:generate -w backend && npm run build",
    "db:deploy": "node scripts/deploy-db.mjs",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "npm run test:e2e -w frontend",
    "setup": "node scripts/setup.mjs",
    "db:backup": "node scripts/backup.mjs",
    "test:prepare": "node scripts/prepare-tests.mjs",
    "test:integration": "npm run test:integration -w backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.6.0",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0",
    "uuid": "^11.1.1"
  }
}
